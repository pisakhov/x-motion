  "audioSha256": "343befce2f25e45b0654fbd1d3d1709ccee59d5a97c2f1484bce334205709576",
  "lines": [
    {
      "start": 4.6,
      "end": 6.7573,
      "text": "White light looks simple. It isn't."
    },
    {
      "start": 7.4,
      "end": 12.2722,
      "text": "Send it through glass, and it comes apart: every colour it was carrying, side by side."
    },
    {
      "start": 13.0,
      "end": 15.8962,
      "text": "Red bends the least. Violet bends the most."
    },
    {
      "start": 22.6,
      "end": 23.9635,
      "text": "Water does it too."
    },
    {
      "start": 24.6,
      "end": 27.9856,
      "text": "A surface moves, and light gathers into bright, living lines."
    },
    {
      "start": 29.4,
      "end": 33.2373,
      "text": "One drop, and the pattern breaks, rings out, and knits itself back together."
    },
    {
      "start": 41.8,
      "end": 44.1241,
      "text": "Glass can gather light, as well as split it."
    },
    {
      "start": 45.0,
      "end": 49.3355,
      "text": "A sphere becomes a lens, and the light it gathers burns to a single point."
    },
    {
      "start": 51.0,
      "end": 54.6197,
      "text": "Even now, the lens in your eye is bending light, to show you this."
    }
  ]
}
