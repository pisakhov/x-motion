  "lines": [
    {
      "start": 4.4,
      "end": 6.1756,
      "text": "Begin with a single drop."
    },
    {
      "start": 7.0,
      "end": 9.5105,
      "text": "Ink never moves the same way twice."
    },
    {
      "start": 10.4,
      "end": 13.6335,
      "text": "It opens, slowly, like a flower under water."
    },
    {
      "start": 15.6,
      "end": 17.888,
      "text": "Then it lets go, and becomes mist."
    },
    {
      "start": 21.4,
      "end": 26.1003,
      "text": "Far mountains need almost no ink at all. The paper does the rest."
    },
    {
      "start": 28.0,
      "end": 31.5875,
      "text": "A crane crosses. No one asks where it is going."
    },
    {
      "start": 39.0,
      "end": 41.7395,
      "text": "Last, the circle. One breath. One stroke."
    },
    {
      "start": 45.0,
      "end": 48.0568,
      "text": "It does not need to be perfect. Only finished."
    }
  ]
}
