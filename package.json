{
  "name": "x-motion",
  "version": "0.1.0",
  "private": true,
  "description": "Short films made by coding agents, published with their prompts and skills",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:site": "node scripts/build-site.mjs",
    "catalog": "node scripts/catalog.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:http": "node scripts/test-http.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "RUN_RENDER_TESTS=1 node --test tests/render-browser.test.mjs",
    "storyboard": "node scripts/render.mjs examples/orbit/passage.html --out renders/passage-board --audio",
    "render": "node scripts/render.mjs examples/orbit/passage.html --out renders/passage --video"
  },
  "devDependencies": { "playwright": "1.65.0" }
}
