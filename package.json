{
  "name": "x-motion",
  "version": "0.1.0",
  "private": true,
  "description": "Skill-first motion design for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "RUN_RENDER_TESTS=1 node --test tests/render-browser.test.mjs",
    "storyboard": "node scripts/render.mjs examples/first-light/index.html --out renders/first-light-board",
    "render": "node scripts/render.mjs examples/first-light/index.html --out renders/first-light --video"
  },
  "devDependencies": { "playwright": "1.65.0" }
}
